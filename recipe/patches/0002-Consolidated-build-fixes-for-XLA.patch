++#
++# The bundled fmt (v11.0.2) implementation of compile-time-checked format
++# strings (FMT_STRING) relies on evaluating a non-constexpr-safe code path
++# inside a consteval constructor. Clang >= 18 rejects this with:
++#   error: call to consteval function ... is not a constant expression
++# because it now propagates immediate-function-context requirements into
++# every sub-expression of a consteval call (matching the C++23 resolution
++# of CWG2334), which fmt 11.0.2 does not yet handle. This affects both
++# spdlog's own call sites and fmt's internal call sites (e.g. bigint
++# formatting), so patch FMT_STRING itself rather than each call site.
++#
++# Since compile-time format-string checking is a diagnostic-only feature
++# (format strings are still checked at runtime), disable it for the
++# bundled fmt used by oneDNN's verbose logging so it builds with newer
++# Clang releases.
++diff --git a/src/common/spdlog/fmt/bundled/format.h b/src/common/spdlog/fmt/bundled/format.h
++index 1111111..2222222 100644
++--- a/src/common/spdlog/fmt/bundled/format.h
+++++ b/src/common/spdlog/fmt/bundled/format.h
++@@ -1824,5 +1824,7 @@
++  *     // A compile-time error because 'd' is an invalid specifier for strings.
++  *     std::string s = fmt::format(FMT_STRING("{:d}"), "foo");
++  */
++-#define FMT_STRING(s) FMT_STRING_IMPL(s, fmt::detail::compile_string, )
+++// Disabled: fmt 11.0.2's FMT_STRING_IMPL trips a consteval-constant-expression
+++// bug with Clang >= 18. Fall back to runtime-checked format strings.
+++#define FMT_STRING(s) s
++
++ template <size_t width, typename Char, typename OutputIt>
