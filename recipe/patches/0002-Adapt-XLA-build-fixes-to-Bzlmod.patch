From 61732b0dcb50d496831b01338526c795c69266da Mon Sep 17 00:00:00 2001
From: Silvio Traversaro <silvio.traversaro@gbionics.ai>
Date: Wed, 18 Nov 2026 15:52:01 -0500
Subject: [PATCH] Adapt XLA build fixes to JAX 0.12.1 Bzlmod

Preserve JAX's existing XLA archive patches and integrate
the conda build fixes through the Bzlmod patch mechanism.

Co-authored-by: Albert Yau <albert@mwyau.com>
---
 MODULE.bazel                            |   1 +
 third_party/xla/conda-build-fixes.patch | 217 ++++++++++++++++++++++++
 2 files changed, 218 insertions(+)
 create mode 100644 third_party/xla/conda-build-fixes.patch

diff --git a/MODULE.bazel b/MODULE.bazel
index 4f46bea..29bd728 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -37,6 +37,7 @@ archive_override(
     patch_strip = 1,
     patches = [
         "//third_party:xla/wsl_vmm_large_allocations.patch",
+        "//third_party:xla/conda-build-fixes.patch",
     ],
     strip_prefix = "xla-97b8433b3ed82b78b742f751d2c7f510e5d78d25",
     urls = ["https://github.com/openxla/xla/archive/97b8433b3ed82b78b742f751d2c7f510e5d78d25.tar.gz"],
diff --git a/third_party/xla/conda-build-fixes.patch b/third_party/xla/conda-build-fixes.patch
new file mode 100644
index 0000000..d15a0e9
--- /dev/null
+++ b/third_party/xla/conda-build-fixes.patch
@@ -0,0 +1,217 @@
+From 5eade54edf69ea22ebddcebc2c350fcf85ff3ea7 Mon Sep 17 00:00:00 2001
+From: Silvio Traversaro <silvio.traversaro@gbionics.ai>
+Date: Wed, 18 Nov 2026 15:52:01 -0500
+Subject: [PATCH] Adapt conda build fixes to XLA for JAX 0.12.1
+
+Retain conda system-library, oneDNN, logging, coordination and platform compatibility fixes on the XLA revision pinned by JAX 0.12.1. The RAFT Clang CUDA workaround is omitted because the improved fix is upstream in openxla/xla#51391.
+
+Co-authored-by: Albert Yau <albert@mwyau.com>
+---
+ third_party/extensions/third_party.bzl        |  1 +
+ third_party/mkl_dnn/mkldnn_system.BUILD       | 22 +++++++++++++++++++
+ third_party/mkl_dnn/workspace.bzl             |  2 ++
+ third_party/repo.bzl                          |  3 +++
+ xla/pjrt/c/BUILD                              |  1 +
+ xla/pjrt/c/pjrt_c_api_gpu.cc                  |  7 +++++-
+ xla/python/BUILD                              |  1 +
+ xla/python/logging.cc                         |  7 +++++-
+ .../coordination_service_agent.cc             | 10 +++++----
+ xla/tsl/mkl/build_defs.bzl                    |  2 ++
+ 10 files changed, 50 insertions(+), 6 deletions(-)
+ create mode 100644 third_party/mkl_dnn/mkldnn_system.BUILD
+
+diff --git a/third_party/extensions/third_party.bzl b/third_party/extensions/third_party.bzl
+index c36b417..12d7cb9 100644
+--- a/third_party/extensions/third_party.bzl
++++ b/third_party/extensions/third_party.bzl
+@@ -133,4 +133,5 @@ def _third_party_ext_impl(mctx):
+ 
+ third_party_ext = module_extension(
+     implementation = _third_party_ext_impl,
++    environ = ["TF_SYSTEM_LIBS"],
+ )
+diff --git a/third_party/mkl_dnn/mkldnn_system.BUILD b/third_party/mkl_dnn/mkldnn_system.BUILD
+new file mode 100644
+index 0000000..35c194d
+--- /dev/null
++++ b/third_party/mkl_dnn/mkldnn_system.BUILD
+@@ -0,0 +1,22 @@
++# Copyright 2026 The OpenXLA Authors. All Rights Reserved.
++#
++# Licensed under the Apache License, Version 2.0 (the "License");
++# you may not use this file except in compliance with the License.
++# You may obtain a copy of the License at
++#
++#     http://www.apache.org/licenses/LICENSE-2.0
++#
++# Unless required by applicable law or agreed to in writing, software
++# distributed under the License is distributed on an "AS IS" BASIS,
++# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
++# See the License for the specific language governing permissions and
++# limitations under the License.
++# ==============================================================================
++
++load("@rules_cc//cc:defs.bzl", "cc_library")
++
++cc_library(
++    name = "mkl_dnn",
++    linkopts = ["-ldnnl"],
++    visibility = ["//visibility:public"],
++)
+diff --git a/third_party/mkl_dnn/workspace.bzl b/third_party/mkl_dnn/workspace.bzl
+index de503be..920995c 100644
+--- a/third_party/mkl_dnn/workspace.bzl
++++ b/third_party/mkl_dnn/workspace.bzl
+@@ -21,6 +21,7 @@ def repo():
+     tf_http_archive(
+         name = "onednn",
+         build_file = "//third_party/mkl_dnn:mkldnn_v1.BUILD",
++        system_build_file = "//third_party/mkl_dnn:mkldnn_system.BUILD",
+         patch_file = ["//third_party/mkl_dnn:setting_tsan_race_v3_7_3.patch"],
+         sha256 = "071f289dc961b43a3b7c8cbe8a305290a7c5d308ec4b2f586397749abdc88296",
+         strip_prefix = "oneDNN-3.7.3",
+@@ -30,6 +31,7 @@ def repo():
+     tf_http_archive(
+         name = "onednn_async",
+         build_file = "//third_party/mkl_dnn:mkldnn_v1_async.BUILD",
++        system_build_file = "//third_party/mkl_dnn:mkldnn_system.BUILD",
+         sha256 = "3f2bc020ecc3d3ffcee48075d6bd0bf6894007b95a04bdf3531ebb0fd2ef00ac",
+         strip_prefix = "oneDNN-3.14.1",
+         urls = tf_mirror_urls("https://github.com/oneapi-src/oneDNN/archive/refs/tags/v3.14.1.tar.gz"),
+diff --git a/third_party/repo.bzl b/third_party/repo.bzl
+index e6b040c..624518f 100644
+--- a/third_party/repo.bzl
++++ b/third_party/repo.bzl
+@@ -38,6 +38,9 @@ def _use_system_lib(ctx, name):
+     syslibenv = _get_env_var(ctx, "TF_SYSTEM_LIBS")
+     if not syslibenv:
+         return False
++    # Repositories created by a module extension have canonical names such as
++    # "<module>++third_party_ext+onednn_async". Match their original name.
++    name = name.rsplit("+", 1)[-1]
+     return name in [n.strip() for n in syslibenv.split(",")]
+ 
+ def _get_link_dict(ctx, link_files, build_file):
+diff --git a/xla/pjrt/c/BUILD b/xla/pjrt/c/BUILD
+index 5032ac1..5210782 100644
+--- a/xla/pjrt/c/BUILD
++++ b/xla/pjrt/c/BUILD
+@@ -738,6 +738,7 @@ cc_library(
+         ":pjrt_c_api_macros",
+         "@com_google_absl//absl/base",
+         "@com_google_absl//absl/log:initialize",
++        "@com_google_absl//absl/log:globals",
+         "@tsl//tsl/platform",
+     ],
+     alwayslink = 1,
+diff --git a/xla/pjrt/c/pjrt_c_api_gpu.cc b/xla/pjrt/c/pjrt_c_api_gpu.cc
+index bce2f16..dea83fb 100644
+--- a/xla/pjrt/c/pjrt_c_api_gpu.cc
++++ b/xla/pjrt/c/pjrt_c_api_gpu.cc
+@@ -17,6 +17,7 @@ limitations under the License.
+ 
+ #include "absl/base/call_once.h"
+ #include "absl/log/initialize.h"
++#include "absl/log/internal/globals.h"
+ #include "tsl/platform/platform.h"
+ #include "xla/pjrt/c/pjrt_c_api.h"
+ #include "xla/pjrt/c/pjrt_c_api_gpu_internal.h"
+@@ -25,7 +26,11 @@ const PJRT_Api* GetPjrtApi() {
+   // Initialize ABSL logging because code within XLA uses it.
+ #ifndef PLATFORM_GOOGLE
+   static absl::once_flag once;
+-  absl::call_once(once, []() { absl::InitializeLog(); });
++  absl::call_once(once, []() {
++    if (!absl::log_internal::IsInitialized()) {
++      absl::InitializeLog();
++    }
++  });
+ #endif  // PLATFORM_GOOGLE
+   return pjrt::gpu_plugin::GetGpuPjrtApi();
+ }
+diff --git a/xla/python/BUILD b/xla/python/BUILD
+index 41e70ea..2f462c8 100644
+--- a/xla/python/BUILD
++++ b/xla/python/BUILD
+@@ -603,6 +603,7 @@ cc_library(
+     visibility = internal_visibility([":friends"]),
+     deps = [
+         "@com_google_absl//absl/log:initialize",
++        "@com_google_absl//absl/log:globals",
+     ],
+ )
+ 
+diff --git a/xla/python/logging.cc b/xla/python/logging.cc
+index 2d8261f..5222fa9 100644
+--- a/xla/python/logging.cc
++++ b/xla/python/logging.cc
+@@ -16,12 +16,17 @@ limitations under the License.
+ #include "xla/python/logging.h"
+ 
+ #include "absl/log/initialize.h"
++#include "absl/log/internal/globals.h"
+ 
+ namespace xla {
+ 
+ // TODO(phawkins): We can't import absl logging in the same file as TSL logging
+ // because of conflicting definitions. We should fix this by using ABSL logging
+ // everywhere.
+-void InitializeAbslLogging() { absl::InitializeLog(); }
++void InitializeAbslLogging() {
++  if (!absl::log_internal::IsInitialized()) {
++    absl::InitializeLog();
++  }
++}
+ 
+ }  // namespace xla
+diff --git a/xla/tsl/distributed_runtime/coordination/coordination_service_agent.cc b/xla/tsl/distributed_runtime/coordination/coordination_service_agent.cc
+index a3b9503..a6518a4 100644
+--- a/xla/tsl/distributed_runtime/coordination/coordination_service_agent.cc
++++ b/xla/tsl/distributed_runtime/coordination/coordination_service_agent.cc
+@@ -55,9 +55,11 @@ limitations under the License.
+ #include "xla/tsl/protobuf/coordination_service.pb.h"
+ 
+ // TODO(b/342448688): Expose via config and API instead of flag.
+-ABSL_FLAG(
+-    bool, coordination_agent_recoverable, false,
+-    "If true, allow it to silently reconnect to the service after a restart.");
++// Avoid duplicate Abseil flag registration when TensorFlow and jaxlib are
++// loaded together. Callers can still set recoverability through the API.
++// ABSL_FLAG(
++//     bool, coordination_agent_recoverable, false,
++//     "If true, allow it to silently reconnect to the service after a restart.");
+ 
+ namespace tsl {
+ using tensorflow::CoordinatedTask;
+@@ -98,7 +100,7 @@ absl::Status CoordinationServiceAgent::Initialize(
+   CoordinatedTask task;
+   task.set_job_name(std::string(job_name));
+   task.set_task_id(task_id);
+-  if (recoverable || absl::GetFlag(FLAGS_coordination_agent_recoverable)) {
++  if (recoverable) {
+     LOG(WARNING)
+         << "Using experimental recoverable task feature. The default shutdown "
+            "barrier will only block non-recoverable tasks. If a synchronized "
+diff --git a/xla/tsl/mkl/build_defs.bzl b/xla/tsl/mkl/build_defs.bzl
+index 7149251..cf0cb87 100644
+--- a/xla/tsl/mkl/build_defs.bzl
++++ b/xla/tsl/mkl/build_defs.bzl
+@@ -112,6 +112,7 @@ def mkl_deps():
+         Label("//xla/tsl:linux_aarch64_with_onednn_async"): ["@onednn_async_aarch64//:mkl_dnn"],
+         Label("//xla/tsl/mkl:build_with_mkl_aarch64"): ["@mkl_dnn_acl_compatible//:mkl_dnn_acl"],
+         Label("//xla/tsl:linux_x86_64"): ["@onednn_async//:mkl_dnn"],
++        Label("//xla/tsl:macos_x86_64"): ["@onednn//:mkl_dnn"],
+         Label("//xla/tsl:windows"): ["@onednn_async//:mkl_dnn"],
+         "//conditions:default": [],
+     })
+@@ -131,6 +132,7 @@ def mkl_dep():
+         Label("//xla/tsl:linux_aarch64_with_onednn_async"): "@onednn_async_aarch64//:mkl_dnn",
+         Label("//xla/tsl/mkl:build_with_mkl_aarch64"): "@mkl_dnn_acl_compatible//:mkl_dnn_acl",
+         Label("//xla/tsl:linux_x86_64"): "@onednn_async//:mkl_dnn",
++        Label("//xla/tsl:macos_x86_64"): "@onednn//:mkl_dnn",
+         Label("//xla/tsl:windows"): "@onednn_async//:mkl_dnn",
+         "//conditions:default": "//xla/tsl/mkl:dummy_mkl_dnn",
+     })
+-- 
+2.53.0
+
