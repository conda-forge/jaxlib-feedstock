++From 449022e5dd0105a0a65d6600f4c94e1b17f914e7 Mon Sep 17 00:00:00 2001
++From: Albert Yau <albert@mwyau.com>
++Date: Mon, 19 Oct 2026 23:19:59 -0400
++Subject: [PATCH] Fix Clang 21/22 RAFT unsigned-long loads
++
++Preserve XLA's Clang compatibility header and warpsort include, and add
++the missing unsigned-long __ldcs overload for Clang 21 and 22.
++
++Original compatibility patch: XLA d867969800d4a8fd045505eabc65e1e66f30794f.
++
++Reference: https://github.com/openxla/xla/pull/51036
++---
++ .../raft/compat/clang_cuda_intrinsics.h       | 286 ++++++++++++++++++
++ .../raft/matrix/detail/select_warpsort.cuh    |   1 +
++ 2 files changed, 287 insertions(+)
++ create mode 100644 cpp/include/raft/compat/clang_cuda_intrinsics.h
++
+ diff --git a/cpp/include/raft/compat/clang_cuda_intrinsics.h b/cpp/include/raft/compat/clang_cuda_intrinsics.h
++new file mode 100644
++index 00000000..4287d0cf
+ --- /dev/null
+ +++ b/cpp/include/raft/compat/clang_cuda_intrinsics.h
+-@@ -0,0 +1,274 @@
++@@ -0,0 +1,286 @@
+ +#pragma once
+ +
+ +#if defined(__clang__) && defined(__CUDA__) && !defined(__NVCC__) && (__clang_major__ < 21)
+@@ -290,10 +295,23 @@ diff --git a/cpp/include/raft/compat/clang_cuda_intrinsics.h b/cpp/include/raft/
+ +#endif // defined(__cplusplus) && (__cplusplus >= 201103L)
+ +
+ +#endif  // clang < 21
+++
+++// Clang 21 and 22 omit this CUDA intrinsic overload; see
+++// https://github.com/openxla/xla/pull/51036.
+++#if defined(__clang__) && defined(__CUDA__) && \
+++    !defined(__NVCC__) && (__clang_major__ >= 21) && (__clang_major__ < 23)
+++inline __device__ unsigned long __ldcs(const unsigned long* ptr) {
+++  if (__SIZEOF_LONG__ == __SIZEOF_LONG_LONG__) {
+++    return (unsigned long)__ldcs((const unsigned long long*)ptr);
+++  }
+++  return (unsigned long)__ldcs((const unsigned int*)ptr);
+++}
+++#endif
+ diff --git a/cpp/include/raft/matrix/detail/select_warpsort.cuh b/cpp/include/raft/matrix/detail/select_warpsort.cuh
++index 1393a440..05764d0a 100644
+ --- a/cpp/include/raft/matrix/detail/select_warpsort.cuh
+ +++ b/cpp/include/raft/matrix/detail/select_warpsort.cuh
+-@@ -16,6 +16,7 @@
++@@ -5,6 +5,7 @@
+  
+  #pragma once
+  
