+diff --git a/third_party/raft/clang21-22-unsigned-long.patch b/third_party/raft/clang21-22-unsigned-long.patch
+new file mode 100644
+index 0000000000..3ac1de5215
+--- /dev/null
++++ b/third_party/raft/clang21-22-unsigned-long.patch
+@@ -0,0 +1,30 @@
++From 2a321340ed9cc18184b29c61c9cf4eb92f925ef0 Mon Sep 17 00:00:00 2001
++From: Albert Yau <albert@mwyau.com>
++Date: Sat, 17 Oct 2026 13:45:30 -0400
++Subject: [PATCH] Fix Clang 21/22 RAFT unsigned-long loads
++
++Clang 21 and 22 lack the __ldcs(const unsigned long*) overload. Clang 23 provides it upstream.
++
++See https://github.com/llvm/llvm-project/pull/190021
++---
++ cpp/include/raft/compat/clang_cuda_intrinsics.h | 10 ++++++++++
++ 1 file changed, 10 insertions(+)
++
++diff --git a/cpp/include/raft/compat/clang_cuda_intrinsics.h b/cpp/include/raft/compat/clang_cuda_intrinsics.h
++index 7a3be33a..0aa326c8 100644
++--- a/cpp/include/raft/compat/clang_cuda_intrinsics.h
+++++ b/cpp/include/raft/compat/clang_cuda_intrinsics.h
++@@ -272,3 +272,13 @@ __INTRINSIC_STORE_FAMILY(wt)
++ #endif // defined(__cplusplus) && (__cplusplus >= 201103L)
++ 
++ #endif  // clang < 21
+++
+++#if defined(__clang__) && defined(__CUDA__) && \
+++    !defined(__NVCC__) && (__clang_major__ >= 21) && (__clang_major__ < 23)
+++inline __device__ unsigned long __ldcs(const unsigned long* ptr) {
+++  if (__SIZEOF_LONG__ == __SIZEOF_LONG_LONG__) {
+++    return (unsigned long)__ldcs((const unsigned long long*)ptr);
+++  }
+++  return (unsigned long)__ldcs((const unsigned int*)ptr);
+++}
+++#endif
