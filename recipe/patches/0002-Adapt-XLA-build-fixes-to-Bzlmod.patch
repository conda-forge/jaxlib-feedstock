++++ b/third_party/repo.bzl
+@@ -38,6 +38,9 @@ def _use_system_lib(ctx, name):
+     syslibenv = _get_env_var(ctx, "TF_SYSTEM_LIBS")
+     if not syslibenv:
+         return False
++    # Repositories created by a module extension have canonical names such as
++    # "<module>++third_party_ext+onednn_async". Match their original name.
++    name = name.rsplit("+", 1)[-1]
+     return name in [n.strip() for n in syslibenv.split(",")]
+ 
+ def _get_link_dict(ctx, link_files, build_file):
